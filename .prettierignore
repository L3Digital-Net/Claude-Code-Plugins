# JS/TS source is owned by each sub-project's own toolchain (the
# home-assistant-dev MCP server's ESLint + tsc), analogous to how this standard
# puts .py source out of Prettier's scope. Recorded as ADR-0001.
# .prettierignore uses gitignore syntax — one pattern per line, no brace expansion.
# A leading-slash-free pattern matches at any depth; *.cjs covers dist/server.bundle.cjs.
*.ts
*.tsx
*.js
*.jsx
*.mjs
*.cjs

# Verbatim Codex audit artifacts (codex-review skill output) — evidence, not authored prose.
docs/codex-reviews/

# Agent Handoff owns exact managed blocks, installed artifacts, status, and tasks.
AGENTS.md
CLAUDE.md
.agents/agent-handoff/
.agents/skills/agent-handoff/
docs/STATUS.md
docs/TODO.md

# Byte mirror of the canonical uv-strict-python skill in agent-configs
# (skills/active/uv-strict-python), which exempts skills/ from Prettier and
# therefore hard-wraps its prose. proseWrap: "never" would unwrap every
# paragraph here, so the copy would stop matching canonical and each upstream
# re-sync would land as a formatting conflict. Update the payload by re-copying
# canonical, never by reformatting it locally.
plugins/uv-strict-python/skills/uv-strict-python/
