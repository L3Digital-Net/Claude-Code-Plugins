{
	// Local runner config (CLI + the VS Code markdownlint extension). NOT part of the
	// published standard — the seedable artifact is .markdownlint.json, which
	// markdownlint-cli2 auto-merges. This file only controls which files a bare
	// `npx markdownlint-cli2` lints and that it honors .gitignore, so a local run
	// matches CI. CI passes `globs` explicitly because the action's own default is
	// the non-recursive `*.{md,markdown}`.
	"globs": ["**/*.md"],
	"gitignore": true,
	"ignores": [
		// docs/codex-reviews/ holds verbatim Codex audit output (codex-review skill,
		// read-only passes); kept as evidence, not authored prose — exempt from style rules.
		"docs/codex-reviews/**",
		// Byte mirror of the canonical uv-strict-python skill in agent-configs
		// (skills/active/uv-strict-python), whose own Markdown stack exempts skills/**.
		// Findings here name style choices that repository cannot accept a fix for:
		// editing them locally would break the byte sync the plugin's
		// check-standard-sync.sh and the upstream re-sync both depend on.
		// (Also Prettier-ignored, for the same reason.)
		"plugins/uv-strict-python/skills/uv-strict-python/**"
	]
}
